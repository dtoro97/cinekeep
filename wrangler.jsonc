{
    "name": "cinekeep",
    "compatibility_date": "2026-05-31",
    "compatibility_flags": ["nodejs_compat"],
    "main": "./dist/cloudflare/server/server.mjs",
    "assets": {
        "directory": "./dist/cloudflare/browser",
        "run_worker_first": ["/", "/index.html"],
    },
    "observability": {
        "enabled": true,
    },
}
