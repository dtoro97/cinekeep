{
  "name": "cinekeep",
  "version": "1.0.0",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:github-pages": "ng build --configuration production,github-pages --base-href https://dtoro97.github.io/cinekeep/",
    "build:cloudflare": "ng build --configuration production,cloudflare",
    "watch": "ng build --watch --configuration development",
    "deploy": "npm run deploy:github-pages",
    "deploy:github-pages": "npm run build:github-pages && npx angular-cli-ghpages --no-silent --dir=dist/github-pages/",
    "preview:cloudflare": "npm run build:cloudflare && npx wrangler dev",
    "deploy:cloudflare": "npm run build:cloudflare && npx wrangler deploy",
    "generate-api": "npx -y @openapitools/openapi-generator-cli generate -i openapi.json -g typescript-angular -o src/app/api --additional-properties=providedIn=root,withInterfaces=true,serviceSuffix=RestControllerService",
    "generate-api:v4": "npx -y @openapitools/openapi-generator-cli generate -i openapi-v4-lists.json -g typescript-angular -o src/app/api-v4 --additional-properties=providedIn=root,withInterfaces=true",
    "serve:ssr:cinekeep": "node dist/cinekeep/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.1.5",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "~21.1.5",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@ngrx/component-store": "^21.0.1",
    "express": "^5.1.0",
    "marked": "^18.0.4",
    "ngx-mat-select-search": "^8.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-cli-ghpages": "^2.0.3",
    "typescript": "~5.9.3"
  }
}
